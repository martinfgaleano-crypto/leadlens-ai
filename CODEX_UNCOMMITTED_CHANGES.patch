diff --git a/.env.example b/.env.example
index 4b7e954..9fe0a14 100644
--- a/.env.example
+++ b/.env.example
@@ -11,6 +11,16 @@ DEMO_MODE=true
 ALLOW_MOCK_LEADS_WITH_REAL_AI=false
 NEXT_PUBLIC_APP_URL=https://leadlens-ai-xi.vercel.app
 
+# Self-serve payments are fail-closed. Keep both false/unset until one provider
+# is selected and its complete payment E2E has passed.
+PAYMENTS_ENABLED=false
+PAYMENT_PROVIDER=
+NEXT_PUBLIC_PAYMENTS_ENABLED=false
+
+# Required only when intentionally running a real pilot E2E. The preflight
+# refuses missing/non-positive values and caps the local harness at $5.
+PILOT_E2E_MAX_USD=
+
 # ─── STEP 1 AFTER LEMON SQUEEZY APPROVAL: Checkout links ─────────────────────
 # Get these from: app.lemonsqueezy.com → Products → [product] → Share button
 #
@@ -86,3 +96,7 @@ FROM_EMAIL=reports@yourdomain.com
 # Apollo data in customer deliverables. Set this to true ONLY after a data
 # licensing / reseller agreement is in place.
 APOLLO_LICENSED_PROVIDER_ENABLED=false
+# Optional list-price overrides used only for transparent token-cost calculation.
+# These do not represent provider invoices or enforce billing limits.
+ANTHROPIC_INPUT_USD_PER_MTOK=3
+ANTHROPIC_OUTPUT_USD_PER_MTOK=15
